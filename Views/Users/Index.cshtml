@model IEnumerable<AppUser>
@{ViewData["Title"]="Users";}<div class="d-flex justify-content-between mb-3"><h1>Users</h1><a asp-action="Create" class="btn btn-primary">Add user</a></div><form method="get" class="d-flex gap-2 mb-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name or email"><button class="btn btn-dark">Search</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></form><table class="table bg-white"><thead><tr><th>Full name</th><th>Email</th><th>Phone</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td>@x.PhoneNumber</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td></tr>}</tbody></table>
